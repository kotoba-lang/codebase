{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        io.github.kotoba-lang/dag-cbor
        {:git/url "https://github.com/kotoba-lang/dag-cbor.git"
         :git/sha "58144e81ccdf7a82367085c66ea21ca84a1a7ddb"}
        io.github.kotoba-lang/io-multiformats
        {:git/url "https://github.com/kotoba-lang/io-multiformats.git"
         :git/sha "561fe7dfada3db852b127f06d41750dabd3cead9"}
        ;; kotoba.value.v1, the shared canonical VALUE codec
        ;; (ADR-kotoba-canonical-value-codec, VC4): semantic-code's literal
        ;; vocabulary is no longer its own. Only the codec is used -- io-ipld's
        ;; node codec (ipld.core/encode) is NOT, and the cbor/multiformats pins
        ;; above deliberately stay NEWER than io-ipld's own (they carry the
        ;; truncated-input and unsigned-key-comparator fixes); io-ipld's suite
        ;; is green against these newer pins.
        ;; The compiler's checked KIR is the definition identity and the
        ;; execution oracle (typed-code / typed-eval). This repo consumes the
        ;; IR; it does not parse source or compile.
        ;; Signed namespace heads (publication). Blocks need no authority --
        ;; a CID either matches its bytes or it does not -- but a head is the
        ;; one mutable claim in the system and is worthless unsigned.
        io.github.kotoba-lang/org-ietf-ed25519
        {:git/url "https://github.com/kotoba-lang/org-ietf-ed25519.git"
         :git/sha "fdcefb9f1b83461fee54d04b63e374fa301ee847"}
        io.github.kotoba-lang/kotoba-kir
        {:git/url "https://github.com/kotoba-lang/kotoba-kir.git"
         :git/sha "73acba38357e701918b24e71b52f6cdda4a22e41"}
        io.github.kotoba-lang/io-ipld
        {:git/url "https://github.com/kotoba-lang/io-ipld.git"
         :git/sha "48ba40490cf082a1473986ac757b8e2b214a3d1b"}
        ;; The provider-neutral block/ref contract the rest of the fleet already
        ;; speaks (ADR-2608580000 D2). It carries ZERO runtime dependencies --
        ;; `kotobase.storage.object-id` assembles base32/multihash/CIDv1 itself
        ;; precisely so it can sit under every provider -- so taking it does not
        ;; drag a storage SDK into the definition plane. `backend/kotobase` is
        ;; the only namespace here that requires it; the filesystem layout stays
        ;; dependency-free and remains the default.
        io.github.kotoba-lang/kotobase-storage
        {:git/url "https://github.com/kotoba-lang/kotobase-storage.git"
         :git/sha "e7f2218cc687c300f4031f9700ec0d0d542849ec"}}
 :aliases
  {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :semantic-cljs
  {:extra-paths ["test-cljs"]
   :extra-deps {org.clojure/clojurescript {:mvn/version "1.12.42"}}
   :main-opts ["-m" "cljs.main"
               "-co" "{:target :nodejs, :output-to \"target/semantic-cljs.js\", :optimizations :none}"
               "-m" "kotoba.codebase.semantic-code-portable-test"]}
  ;; The evaluation layer under ClojureScript, against an in-memory
  ;; ICodebaseStore. `:semantic-cljs` proves the two runtimes agree on a hash;
  ;; this proves the hash is RUNNABLE on the side kotobase deploys to.
  :eval-cljs
  {:extra-paths ["test-cljs"]
   :extra-deps {org.clojure/clojurescript {:mvn/version "1.12.42"}}
   :main-opts ["-m" "cljs.main"
               "-co" "{:target :nodejs, :output-to \"target/eval-cljs.js\", :optimizations :none}"
               "-m" "kotoba.codebase.evaluation-portable-test"]}

  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
